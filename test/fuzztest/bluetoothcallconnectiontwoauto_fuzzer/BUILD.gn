#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/ohos.gni")
import("//build/test.gni")
import("../../../callmanager.gni")

##############################fuzztest##########################################
CALL_MANAGER_PATH = "../../.."
ohos_fuzztest("BluetoothCallConnectionTwoAutoFuzzTest") {
  module_output_path = "call_manager/call_manager"
  module_out_path = module_output_path
  fuzz_config_file =
      "${CALL_MANAGER_PATH}/test/fuzztest/bluetoothcallconnectiontwoauto_fuzzer"

  include_dirs = [
    "${CALL_MANAGER_PATH}/interfaces/innerkits",
    "${CALL_MANAGER_PATH}/test/fuzztest/common_fuzzer",
  ]
  include_dirs += call_manager_include_dirs
  # 注意：frameworks/native/include 必须置于 call_manager_include_dirs 之后，
  # 避免 call_ability_callback_death_recipient.h 遮蔽 services/call_report/include 版本导致编译失败
  include_dirs += [ "${CALL_MANAGER_PATH}/frameworks/native/include" ]

  deps = [
    "${CALL_MANAGER_PATH}/frameworks/native:tel_call_manager_api",
  ]

  external_deps = [
    "access_token:libnativetoken_shared",
    "access_token:libtoken_setproc",
    "cJSON:cjson",
    "libphonenumber:phonenumber_standard",
    "protobuf:protobuf_lite",
  ]
  external_deps += call_manager_external_deps

  defines = [
    "TELEPHONY_LOG_TAG = \"BluetoothCallConnectionTwoFuzzTest\"",
    "LOG_DOMAIN = 0xD000F00",
  ]
  defines += call_manager_defines

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  sources = [
    "${CALL_MANAGER_PATH}/test/fuzztest/common_fuzzer/addcalltoken_fuzzer.cpp",
    "bluetoothcallconnectiontwoauto_fuzzer.cpp",
  ]
  sources += call_manager_sources
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":BluetoothCallConnectionTwoAutoFuzzTest",
  ]
}
###############################################################################
